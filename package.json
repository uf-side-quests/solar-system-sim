{
  "name": "solar-system-time-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "docs:lint": "markdownlint-cli2 'docs/**/*.md' README.md THIRD_PARTY_NOTICES.md",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:sbdb": "node scripts/fetch-sbdb-snapshot.mjs",
    "data:horizons": "node scripts/fetch-horizons-major-bodies.mjs",
    "data:horizons-satellites": "node scripts/fetch-horizons-known-satellites.mjs",
    "data:horizons-regression": "node scripts/fetch-horizons-regression.mjs",
    "data:naif": "node scripts/generate-naif-snapshots.mjs",
    "data:nasa-assets": "node scripts/fetch-nasa-assets.mjs",
    "data:stars": "node scripts/fetch-hipparcos-stars.mjs",
    "wasm:build": "bash scripts/build-rebound-wasm.sh",
    "wasm:verify": "node scripts/verify-rebound-wasm.mjs",
    "jpl:verify": "node scripts/verify-jpl-regression.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm docs:lint && pnpm typecheck && pnpm test",
    "complete": "pnpm check && pnpm build && pnpm wasm:verify && pnpm jpl:verify && pnpm test:e2e"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "comlink": "4.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satellite.js": "7.1.0",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.5",
    "@webgpu/types": "0.1.71",
    "eslint": "10.8.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
